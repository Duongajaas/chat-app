# URL của backend API (ChatApp .NET)
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth Client ID, lấy từ Google Cloud Console
# Phải trùng với GoogleAuth:ClientId trong appsettings.json của backend
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Public GIPHY client key, included in the browser build. Never put server secrets in VITE_* variables.
VITE_GIPHY_API_KEY=
