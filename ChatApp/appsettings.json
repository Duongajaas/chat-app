{
  "Logging": {
  "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Information"
  }
},
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=chatappdb;Username=admin;Password=password123;"
  },

  "Jwt": {
    "Issuer": "ChatApp",
    "Audience": "ChatApp.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 1,
    "RefreshTokenDays": 30
  },

  "Cors": {
  "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },

  "GoogleAuth": {
    "ClientId": ""
  },

  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 5, "WindowSeconds": 300 },
    "RefreshToken": { "PermitLimit": 20, "WindowSeconds": 60 },
    "ForgotPassword": { "PermitLimit": 3, "WindowSeconds": 300 },
    "ResetPassword": { "PermitLimit": 5, "WindowSeconds": 300 },
    "GoogleLogin": { "PermitLimit": 10, "WindowSeconds": 60 },
    "ResolveFriendLink": { "PermitLimit": 20, "WindowSeconds": 60 },
    "GetMessages": { "PermitLimit": 60, "WindowSeconds": 60 }
  },

  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  }
}