# Copy to .env.production outside source control. Supply real values; do not commit them.
APP_VERSION=release-1
# All API instances of this deployment must use the same Redis channel prefix.
# Use a different prefix for a separate application/environment sharing Redis.
REDIS_CHANNEL_PREFIX=chatapp-production
PUBLIC_ORIGIN=https://chat.example.com
POSTGRES_DB=chatapp
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=
JWT_SECRET=
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Contains fullchain.pem and privkey.pem readable by the nginx container user.
TLS_DIRECTORY=/absolute/path/to/tls
